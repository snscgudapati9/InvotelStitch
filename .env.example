# Copy this file to .env (for local dev) and set the same variable in
# Vercel → Project → Settings → Environment Variables (for the live site).
#
# This is what fixes "data shows zero when I share the link" — without it,
# every new browser/visitor starts with empty local storage and never
# automatically connects to your shared Google Sheet.

VITE_BACKEND_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec
